[Unit]
Description=Apple T2 CDC-NCM Transport & Touch ID Link Initialization
DefaultDependencies=no
After=systemd-udevd.service systemd-udev-settle.service
Before=network.target t2-touchid.service
Wants=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/t2-touchid-bridge-init.sh

[Install]
WantedBy=multi-user.target
